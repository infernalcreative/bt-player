[Unit]
Description=FastAPI Bluetooth Audio Player Service
After=network.target bluetooth.service bluealsa.service

[Service]
User=root
WorkingDirectory=/opt/bt-player
ExecStart=/opt/bt-player/venv/bin/uvicorn main:app --host 10.21.77.50 --port 55300
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
